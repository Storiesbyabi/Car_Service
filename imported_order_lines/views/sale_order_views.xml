<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
 <record id="sale_order_views_form" model="ir.ui.view">
        <field name="name" >sale.order.form.inherit.order</field>
        <field name="model" >sale.order</field>
        <field name="inherit_id"  ref="sale.view_order_form" />
        <field name="arch" type="xml" >
                    <xpath expr="//button[@name='action_cancel']" position="after" >
                <button name="action_wizard" type="object" class="btn-primary" string="Import Order"/>
                </xpath>
        </field>
    </record>
</odoo>