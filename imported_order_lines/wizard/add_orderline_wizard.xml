<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="orderline_wizard_view_form" model="ir.ui.view">
        <field name="name">orderline.wizard.view.form</field>
        <field name="model">add.orderline.wizard</field>
        <field name="arch" type="xml">
            <form string="Orderline Wizard">
                <group>
                <field name="file" string="File" options="{'accepted_file_extensions': '.xlsx'}" />
                 </group>
                <footer>
                <button string="Import" type="object" class="btn-primary" name="action_import" />
                    <button string="Cancel" special="cancel" type="object"/>
                </footer>
            </form>
        </field>
</record>

</odoo>