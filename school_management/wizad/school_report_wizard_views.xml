<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="school_report_wizard_view_form" model="ir.ui.view">
        <field name="name">school.report.wizard.view.form</field>
        <field name="model">school.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Wizard">
                <group>
                    <field name="student_leave" invisible=" report_type != 'leave'"/>
                    <field name="students_ids" invisible=" student_leave == 'class' " widget="many2many_tags" />
                    <field name="student_info" invisible=" report_type != 'student'"/>
                    <field name="class_ids" widget="many2many_tags" invisible=" report_type == 'club' or student_info == 'department' or student_leave == 'student' " options="{'no_create': True}" />
                    <field name="type_selection" invisible=" report_type != 'leave'" />
                    <field name="department_ids" invisible=" report_type != 'student' or student_info == 'class' " widget="many2many_tags" options="{'no_create': True}" />
                    <field name="club_ids" invisible=" report_type != 'club'" widget="many2many_tags" options="{'no_create': True}" />
                    <field  name="start_date" widget="daterange" options="{'end_date_field':'end_date'}" invisible=" type_selection != 'custom' " />
                    <field name="end_date" invisible="1" />
                </group>
                <footer>
                <button string="Print Report" type="object" class="btn-primary" name="action_print" />
                    <button string="Cancel" special="cancel" type="object"/>
                </footer>
            </form>
        </field>
</record>

    <record id="leave_information_views_action" model="ir.actions.act_window">
        <field name="name">Leave Information</field>
        <field name="res_model">school.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'report_type':'leave'}</field>
    </record>
    <record id="club_data_views_action" model="ir.actions.act_window">
        <field name="name">Club Data</field>
        <field name="res_model">school.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'report_type':'club'}</field>
    </record>
    <record id="student_information_views_action" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="res_model">school.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'report_type':'student'}</field>
    </record>


</odoo>