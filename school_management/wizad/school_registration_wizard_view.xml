<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_registration_wizard_view_form" model="ir.ui.view">
        <field name="name">school.registration.wizard.view.form</field>
        <field name="model">school.registration.wizard</field>
        <field name="arch" type="xml">
            <form string="Registration Wizard">
                <group>
                    <field name="firstname" required="True"/>
                    <field name="lastname"/>
                    <field name="email" widget="email"/>
                    <field name="phone" widget="phone"/>
                    <field name="aadhar_number"/>
                </group>
                <footer>
                    <button string="Register" type="object" name="action_register" />
                    <button string="Cancel"/>
                </footer>


            </form>

        </field>


    </record>


</odoo>