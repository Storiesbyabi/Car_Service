<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_leave_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h1>Leave Reports</h1>
                    </div>
                    <t t-foreach="report" t-as="o">
                        <h3>Class
                            <t t-if="docs.student_leave == 'class'">
                                <t t-esc="o['class']"/>
                            </t>
                            <t t-else="">
                                <t t-esc="o['firstname']"/>
                            </t>
                        </h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <t t-if="docs.student_leave == 'class'">
                                        <th style="padding:12px" scope="col">Students Name</th>
                                        <th style="padding:12px">Admission no</th>
                                        <th style="padding:12px">Start Date</th>
                                        <th style="padding:12px">End Date</th>
                                        <th style="padding:12px">Total days</th>
                                    </t>
                                    <t t-else="">
                                        <th style="padding:12px">Admission no</th>
                                        <th style="padding:12px">Start Date</th>
                                        <th style="padding:12px">End Date</th>
                                        <th style="padding:12px">Total days</th>
                                        <th style="padding:12px">email</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <t t-if="docs.student_leave == 'class'">
                                        <td style="padding:12px">
                                            <t t-esc="o['firstname']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['admission_number']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['start_date']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['end_date']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['total_days']"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td style="padding:12px">
                                            <t t-esc="o['admission_number']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['start_date']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['end_date']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['total_days']"/>
                                        </td>
                                        <td style="padding:12px">
                                            <t t-esc="o['email']"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>

    </template>
</odoo>