<odoo>

    <record id="school_management_view_list" model="ir.ui.view">
        <field name="name">school.management.view.list</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">

            <list string="Registration list">
                <field name="firstname"/>
                <field name="lastname"/>

            </list>

        </field>
    </record>
    <record id="school_management_view_form" model="ir.ui.view">
        <field name="name">school.management.view.form</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">

            <form string="Registration form">
                <sheet>
                    <group>
                        <field name="firstname"/>
                        <field name="lastname"/>
                        <field name="father"/>
                        <field name="mother"/>
                        <field name="communication_address"/>
                        <field name="same_as_communication_address"/>
                        <field name="permanent_address" invisible="same_as_communication_address == True" />
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="dob"/>
                        <field name="gender"/>
                        <field name="registration_date"/>
                        <field name="photo"/>
                        <field name="previous_academic_department"/>
                        <field name="previous_class" domain="[('department_id','in',previous_academic_department)]" />
                        <field name="tc"/>
                        <field name="aadhar_number"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>


</odoo>