<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_academic_year_views_list" model="ir.ui.view">
        <field name="name">school.academic.year.view.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Year list" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="school_academic_year_views_search" model="ir.ui.view" >
        <field name="name" >school.academic.year.view.search</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <search >
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="school_academic_year_views_action" model="ir.actions.act_window">
            <field name="name">Manage Academic Year</field>
            <field name="res_model">school.academic.year</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>