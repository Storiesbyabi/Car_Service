<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="school_subject_views_list" model="ir.ui.view">
        <field name="name">school.subject.view.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">

            <list string="Subject list">
                <field name="name"/>
                <field name="department_id" />
            </list>

        </field>
    </record>
    <record id="school_subject_views_form" model="ir.ui.view">
        <field name="name">school.subject.view.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">

            <form string="Subject form">
                <sheet>
                <group>
                <field name="name"/>
                <field name="department_id" />
                </group>
                </sheet>
                <chatter />
            </form>

        </field>
    </record>
    <record id="school_subject_views_search" model="ir.ui.view">
        <field name="name">school.subject.view.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">

            <search>
                <field name="name"/>
                <field name="department_id" />
            </search>

        </field>
    </record>

    <record id="school_subject_views_action" model="ir.actions.act_window">
            <field name="name">Manage Subject</field>
            <field name="res_model">school.subject</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>
