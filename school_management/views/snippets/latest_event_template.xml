<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="latest_event" name="Latest Events">
       <section class="events_section">
           <div class="container">
               <div class="alert alert-info">
                   <h4>Your Category Highlight Tab snippet will be displayed here...
                       Please save to view the snippet
                   </h4>
               </div>
           </div>
       </section>
   </template>
   <template id="latest_event_snippet" inherit_id="website.snippets"
             name="Latest Events Snippet">
       <xpath expr="//snippets[@id='snippet_groups']" position="inside">
           <t t-snippet="school_management.latest_event"
              t-thumbnail="/school_management/static/src/images.jpeg"/>
       </xpath>
       <xpath expr="//snippets[@id='snippet_structure']" position="inside">
           <t t-snippet="school_management.latest_event"/>
       </xpath>
   </template>
</odoo>