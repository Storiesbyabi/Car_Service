<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_registration_view_list" model="ir.ui.view">
        <field name="name">school.registration.view.list</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <list string="Registration list">
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="registration_date"/>
            </list>
        </field>
    </record>
    <record id="school_registration_view_form" model="ir.ui.view">
        <field name="name">school.registration.view.form</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <form string="Registration form">
                <header>
                    <button name="action_register" type="object" class="btn btn-primary btn-md mb-4 " string="Register"
                            invisible="status != 'draft' "/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,registration"
                           options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="register_sequence" readonly="True" class="oe_inline oe_highlight"/>
                        </h1>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <group col="2">
                        <group>
                            <field name="firstname" required="True"/>
                            <field name="lastname"/>
                            <field name="father"/>
                            <field name="mother"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="registration_date"/>
                            <field name="aadhar_number"/>
                        </group>
                        <notebook>
                            <page string="Address">
                                <group>
                                    <field name="communication_address"/>
                                    <field name="same_as_communication_address"/>
                                    <field name="permanent_address" invisible="same_as_communication_address == True"/>
                                </group>
                            </page>
                            <page string="School Details">
                                <group>
                                    <field name="previous_academic_department_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="previous_class_id"
                                           domain="[('department_id','in',previous_academic_department_id)]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="tc" options="{'accepted_file_extensions': '.pdf'}"/>
                                </group>
                            </page>
                            <page name="exam_page" string="Exam" invisible="is_student == False">
                                <group>
                                     <field name="exam_ids" options='{"no_open": True, "no_create": True}'>
                                    <list editable="bottom">
                                       <field name="name" />
                                    </list>
                                     </field>
                                </group>

                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="school_registration_view_search" model="ir.ui.view">
        <field name="name">school.registration.view.search</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="registration_date"/>
            </search>
        </field>
    </record>
</odoo>
