<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="school_class_view_list" model="ir.ui.view">
        <field name="name">school.class.view.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">

            <list string="Class list">
                <field name="name"/>
                <field name="department_id" />
            </list>

        </field>
    </record>
    <record id="school_class_view_form" model="ir.ui.view">
        <field name="name">school.class.view.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">

            <list string="Class form">
                <field name="name"/>
                <field name="department_id" />
            </list>

        </field>
    </record>

    <record id="school_class_view_search" model="ir.ui.view">
        <field name="name">school.class.view.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">

            <search >
                <field name="name"/>
                <field name="department_id" />
            </search>

        </field>
    </record>

</odoo>