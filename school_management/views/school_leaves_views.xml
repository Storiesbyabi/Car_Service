<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_leaves_view_list" model="ir.ui.view">
        <field name="name">school.leaves.view.list</field>
        <field name="model">school.leaves</field>
        <field name="arch" type="xml">
            <list string="Leaves list">
                <field name="students_id"/>
                <field name="class_id"/>
            </list>
        </field>
    </record>
    <record id="school_leaves_view_form" model="ir.ui.view">
        <field name="name">school.leaves.view.form</field>
        <field name="model">school.leaves</field>
        <field name="arch" type="xml">
            <form string="Leaves form">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn btn-primary" invisible="is_leave == True"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm" />
                </header>
                <sheet>
                <group>
                    <field name="students_id" readonly="is_leave == True"/>
                <field name="class_id" readonly="is_leave == True" />
                    <field  name="start_date" widget="daterange" options="{'end_date_field':'end_date'}" readonly="is_leave == True"/>
                    <field name="end_date" invisible="1" readonly="is_leave == True"/>
                    <field name="total_days" />
                    <field name="half_day" readonly="is_leave == True"/>
                    <field name="reason" readonly="is_leave == True"/>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="school_leaves_view_search" model="ir.ui.view">
        <field name="name">school.leaves.view.search</field>
        <field name="model">school.leaves</field>
        <field name="arch" type="xml">
            <search>
                <field name="students_id"/>
                <field name="class_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_days"/>
                <field name="half_day"/>
                <filter name="Class" context="{'group_by':'class_id'}" string="Class" />
            </search>
        </field>
    </record>

    <record id="school_leaves_view_action" model="ir.actions.act_window">
            <field name="name">Leaves</field>
            <field name="res_model">school.leaves</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>