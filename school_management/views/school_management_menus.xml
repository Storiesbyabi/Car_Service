<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="school_registration_action" model="ir.actions.act_window">
            <field name="name">Registration</field>
            <field name="res_model">school.registration</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_department_view_action" model="ir.actions.act_window">
            <field name="name">Manage Department</field>
            <field name="res_model">school.department</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_class_view_action" model="ir.actions.act_window">
            <field name="name">Manage Class</field>
            <field name="res_model">school.class</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_subject_view_action" model="ir.actions.act_window">
            <field name="name">Manage Subject</field>
            <field name="res_model">school.subject</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_academic_year_view_action" model="ir.actions.act_window">
            <field name="name">Manage Academic Year</field>
            <field name="res_model">school.academic.year</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_students_view_action" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">school.students</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('status', '=', 'registration')]</field>

        </record>

        <record id="school_clubs_view_action" model="ir.actions.act_window">
            <field name="name">Manage Clubs</field>
            <field name="res_model">school.clubs</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_events_view_action" model="ir.actions.act_window">
            <field name="name">Manage Events</field>
            <field name="res_model">school.events</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_leaves_view_action" model="ir.actions.act_window">
            <field name="name">Leaves</field>
            <field name="res_model">school.leaves</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_exams_view_action" model="ir.actions.act_window">
            <field name="name">Exams</field>
            <field name="res_model">school.exams</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="school_teachers_view_action" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('partner_selection', '=', 'teacher')]</field>

        </record>
        <record id="school_office_staffs_view_action" model="ir.actions.act_window">
            <field name="name">Office Staffs</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('partner_selection', '=', 'student')]</field>

        </record>


        <menuitem id="school_management_root" name="School Management"/>
        <menuitem id="school_registration_student_root"
                  name="Student"
                  parent="school_management_root"
                  sequence="1"
        />
        <menuitem id="school_action"
                  parent="school_registration_student_root"
                  action="school_registration_action"/>
        <menuitem id="school_student_action"
                  parent="school_registration_student_root"
                  action="school_students_view_action"/>
        <menuitem id="school_leaves_action"
                  parent="school_registration_student_root"
                  action="school_leaves_view_action"/>
        <menuitem id="school_exams_action"
                  parent="school_registration_student_root"
                  action="school_exams_view_action"/>
        <menuitem
                id="school_management_Employees_root"
                parent="school_management_root"
                name="Employees"
                sequence="2"
        />
        <menuitem
                id="school_management_configuration_root"
                parent="school_management_root"
                name="Configuration"
                sequence="3"
        />
        <menuitem
                id="school_department_view_configuration_action"
                parent="school_management_configuration_root"
                action="school_department_view_action"
        />
        <menuitem id="school_class_view_configuration_action"
                  parent="school_management_configuration_root"
                  action="school_class_view_action"
        />
        <menuitem id="school_subject_view_configuration_action"
                  parent="school_management_configuration_root"
                  action="school_subject_view_action"
        />
        <menuitem id="school_academic_year_view_configuration_action"
                  parent="school_management_configuration_root"
                  action="school_academic_year_view_action"
        />
        <menuitem id="school_clubs_view_configuration_action"
                  parent="school_management_configuration_root"
                  action="school_clubs_view_action"
        />
        <menuitem id="school_events_view_configuration_action"
                  parent="school_management_configuration_root"
                  action="school_events_view_action"
        />
        <menuitem id="school_teachers_view_employees_action"
                  parent="school_management_Employees_root"
                  action="school_teachers_view_action"
        />
        <menuitem id="school_office_staffs_view_employees_action"
                  parent="school_management_Employees_root"
                  action="school_office_staffs_view_action"
        />
    </data>
</odoo>