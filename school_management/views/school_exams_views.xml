<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_exams_view_list" model="ir.ui.view">
        <field name="name">school.exams.view.list</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <list string="Exams list">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="school_exams_view_form" model="ir.ui.view">
        <field name="name">school.exams.view.form</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <form string="Exams form">
                <header>
                    <button name="action_add" type="object" class="btn btn-primary" string="Add" help="Add exam to students" />
                </header>
                <sheet>
                <group>
                    <field name="name" string="Exam name" />
                    <field name="class_id" options="{'no_create':True}"/>
                    </group>
                    <notebook>
                          <page string="Papers">
                              <group>
                              <field name="papers_ids" string="">
                                  <list editable="bottom">
                                      <field  name="subject_id" options="{'no_create':True}"/>
                                      <field name="pass_mark" />
                                      <field name="max_mark" />
                                  </list>
                              </field>
                              </group>
                          </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
     <record id="school_exams_view_search" model="ir.ui.view">
        <field name="name">school.exams.view.search</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Exam"/>
                <field name="class_id" string="Class"/>
                <field name="papers_ids" string="Subject"/>
                <filter name="Class" context="{'group_by':'class_id'}" string="Class" />
            </search>
        </field>
    </record>


</odoo>