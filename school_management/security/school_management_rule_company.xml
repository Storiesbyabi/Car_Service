<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
   <record id="company_record_rule" model="ir.rule">
        <field name="name">Company filter</field>
        <field name="model_id" ref="model_school_registration"/>
        <field name="domain_force">[('company_id', '=', company_ids)]</field>
    </record>
    <record id="company_class_record_rule" model="ir.rule">
        <field name="name">Company class filter</field>
        <field name="model_id" ref="model_school_class"/>
        <field name="domain_force">[('school_id', '=', company_ids)]</field>
    </record>
</odoo>