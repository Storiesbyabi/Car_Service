<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="school_leave_report_wizard_view_form" model="ir.ui.view">
        <field name="name">school.leave.report.wizard.view.form</field>
        <field name="model">school.leave.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Wizard">
                <group>
                    <field name="student_leave"/>
                    <field name="students_ids" invisible="student_leave == 'class' " widget="many2many_tags" />
                    <field name="class_ids" widget="many2many_tags" invisible="student_leave == 'student' " options="{'no_create': True}" />
                    <field name="type_selection"/>
                    <field  name="start_date" widget="daterange" options="{'end_date_field':'end_date'}" invisible=" type_selection != 'custom' " />
                    <field name="end_date" invisible="1" />
                </group>
                <footer>
                <button string="Print PDF" type="object" class="btn-primary" name="action_print" />
                    <button string="Print XLSX" type="object" class="btn-primary" name="action_xlsx_report" />
                    <button string="Cancel" special="cancel" type="object"/>
                </footer>
            </form>
        </field>
</record>

    <record id="leave_information_views_action" model="ir.actions.act_window">
        <field name="name">Leave Information</field>
        <field name="res_model">school.leave.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>