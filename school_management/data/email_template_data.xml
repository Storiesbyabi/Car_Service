<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="email_template_data" model="mail.template">
            <field name="name">Email Template</field>
            <field name="model_id" ref="school_management.model_school_events"/>
            <field name="subject">Subject {{ object.name }}</field>
            <field name="email_from">
                {{ user.email_formatted }}
            </field>
            <field name="partner_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                        Hello<t t-out="object.partner_id.complete_name"/>,
                        <br/>
                        The
                        <t t-out="object.name"/>
                        event will be held on<t t-out="object.date_begin"/>.
                        The event will be organized by<t t-out="object.organizer_id.name"/>.
                        <br/>
                        <br/>
                        <t t-out="object.description"/>
                    </p>
                </div>
                <img t-att-src="'data:image/jpeg;base64,%s' % ctx.get('poster')" width="540"
                     class="illustration_border"/>
            </field>
        </record>
    </data>
</odoo>