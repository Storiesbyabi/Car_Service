<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="action_create_user" model="ir.actions.server" >
            <field name="name" >Create user from student</field>
            <field name="model_id" ref="school_management.model_school_students" />
            <field name="state">code</field>
            <field name="code">
               action= record._action_user_creation()
            </field>
        </record>
        <record id="automated_action_create_user_on_student" model="base.automation">
        <field name="name">Create user while creating student</field>
        <field name="model_id" ref="school_management.model_school_students"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(ref('action_create_user'))]"/>
    </record>
    </data>
</odoo>