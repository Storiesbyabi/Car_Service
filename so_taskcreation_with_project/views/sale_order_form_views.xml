<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_form_views" model="ir.ui.view">
        <field name="name" >sale.order.form.views</field>
        <field name="model" >sale.order</field>
        <field name="inherit_id"  ref="sale.view_order_form" />
        <field name="arch" type="xml" >

            <xpath expr="//field[@name='payment_term_id']" position="after" >
                <field name="related_project_id" string="Related Project" domain="[('partner_id','=',partner_id)]"/>
                </xpath>
            <xpath expr="//button[@name='payment_action_capture']" position="before" >
                <button name="action_task" type="object" string="Create Task" class="btn-primary" invisible="state != 'sale' and not related_project_id.task_ids and not related_project_id" />
                </xpath>
            <xpath expr="//div[@name='button_box']" position="inside" >
                <button name="action_smart_btn" type="object" string="Task" class="oe_stat_button" icon="fa-id-card-o" />
                </xpath>


        </field>
    </record>
</odoo>