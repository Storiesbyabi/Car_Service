<odoo>



    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">

            <!--            List View start -->
            <list string="Estate"  decoration-success="state == 'received' or state == 'offer_accepted' " decoration-bf="state == 'offer_accepted'" decoration-muted="state== 'sold'" >
                <field string="Title" name='name'/>
                <field name="property_tags_ids" widget="many2many_tags" />
                <field name='postcode'/>
                <field name="property_type_id"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living area"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price "/>
                <field name="date_availability" string="Available From" optional="hide"/>
                <field name="property_offers_ids">
                    <list>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </list>


                </field>

            </list>
            <!--            List view End -->
        </field>
    </record>




    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <!--            Form view Start -->

            <form string="Test">
                <header>
                    <button name="action_sold"  type="object" string="Sold" invisible="state == 'sold' or state == 'cancelled' " />
                    <button name="action_cancelled" type="object" string="Cancel" invisible="state == 'cancelled' or state == 'sold' "/>
                </header>
                <field name="state" widget="statusbar" statusbar_visible="new,offer,received,offer_accepted,sold"/>

                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="property_tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group col="2">
                        <group>
                            <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="postcode"/>

                            <field name="date_availability"/>
                        </group>

                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>

                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">

                            <group>
                                <field name="description" string="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden" />
                                <field name="garden_orientation" invisible="not garden" />
                                <field name="state"/>
                                <field name="active"/>
                                <field name="total"/>
                            </group>
                        </page>


                        <page string="Offers">
                            <group>
                                <field name="property_offers_ids" readonly="state == 'offer_accepted' or state == 'sold' or state == 'cancelled' ">
                                    <list editable="top" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'" decoration-muted="status == 'accepted'" >
                                        <field name="price"/>
                                        <field name="property_id"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                     <button name="action_accept" string="Confirm"  type="object" icon="fa-check"  invisible= "status == 'accepted' or status == 'refused' "/>
                                     <button name="action_cancel" string="Refuse"  type="object" icon="fa-times" invisible= "status == 'accepted' or status == 'refused' " />
                                        <field name="status"/>
                                    </list>

                                </field>
                            </group>


                        </page>

                        <page string="Other info">
                            <group>
                                <field name="salesman"/>
                                <field name="buyer"/>
                            </group>

                        </page>
                    </notebook>
                </sheet>
            </form>
            <!--          Form view End  -->

        </field>
    </record>

    <!--    Search Start -->
    <record id="estate_property_filter" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="['|',('living_area','=',self),('living_area','>',self)]" />
                <field name="facades"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
                <field name="property_type_id"/>


                <filter name="Available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer')]"/>
                <filter name="Postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <!--    Search End -->


</odoo>