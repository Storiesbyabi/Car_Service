<odoo>



    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <!--            List View start -->
            <list string="Estate">
                <field string="Title" name='name'/>
                <field name="property_tags_ids" widget="many2many_tags"/>
                <field name='postcode'/>
                <field name="property_type_id"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living area"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price "/>
                <field name="date_availability" string="Available From"/>
                <field name="property_offers_ids">
                    <list>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </list>


                </field>

            </list>
            <!--            List view End -->
        </field>
    </record>





    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <!--            Form view Start -->

            <form string="Test">
                <header>
                    <button name="action_sold"  type="object" string="Sold"/>
                    <button name="action_cancelled" type="object" string="Cancel"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="property_tags_ids" widget="many2many_tags"/>
                    <group col="2">
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>

                            <field name="date_availability"/>
                        </group>

                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>

                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">

                            <group>
                                <field name="description" string="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="state"/>
                                <field name="active"/>
                                <field name="total"/>
                            </group>
                        </page>


                        <page string="Offers">
                            <group>
                                <field name="property_offers_ids">
                                    <list>
                                        <field name="price"/>


                                        <field name="property_id"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                     <button name="action_accept" string="Confirm"  type="object" icon="fa-check"/>
                                     <button name="action_cancel" string="Refuse"  type="object" icon="fa-times"/>
                                        <field name="status"/>
                                    </list>

                                </field>
                            </group>


                        </page>

                        <page string="Other info">
                            <group>
                                <field name="salesman"/>
                                <field name="buyer"/>
                            </group>

                        </page>
                    </notebook>
                </sheet>
            </form>
            <!--          Form view End  -->

        </field>
    </record>

    <!--    Search Start -->
    <record id="estate_property_filter" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
                <field name="property_type_id"/>


                <filter name="Available properties" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer')]"/>
                <filter name="Postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <!--    Search End -->


</odoo>