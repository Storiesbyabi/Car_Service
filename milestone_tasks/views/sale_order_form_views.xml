<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_form_views" model="ir.ui.view">
        <field name="name" >sale.order.form.views</field>
        <field name="model" >sale.order</field>
        <field name="inherit_id"  ref="sale.view_order_form" />
        <field name="arch" type="xml" >

            <xpath expr="//button[@name='payment_action_capture']" position="before" >
                <button type="object" name="action_project" string="Create Project" class="btn-primary" invisible="flag == True"/>
                </xpath>
            <xpath expr="//button[@name='payment_action_capture']" position="before" >
                <button type="object" name="action_update_project" string="Update Project" class="btn-primary" invisible="flag == False"/>
                </xpath>

                        <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="before" >
                <field  name="milestone" />
                </xpath>


<!--            <xpath expr="//div[@name='button_box']" position="inside" >-->
<!--                <button name="action_smart_btn" type="object" string="Task" class="oe_stat_button" icon="fa-id-card-o" />-->
<!--                </xpath>-->


        </field>
    </record>
</odoo>