<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pos_wizard_view_form" model="ir.ui.view">
        <field name="name">pos.wizard.view.form</field>
        <field name="model">pos.wizard</field>
        <field name="arch" type="xml">
            <form string="Payment Wizard">
                <group>
                    <field name="total_amount"  options="{'no_create': True}" />
                    <field name="paid_amount"  options="{'no_create': True}" />
                    <field name="remaining_amount" readonly="True" options="{'no_create': True}" />
                </group>
                <field name="wizard_ids">
                <list editable="bottom">
                <field name="payment_method_id"  options="{'no_create': True}" />
                    <field name="amount"/>
                 </list>
                </field>
                <footer>
                    <button string="Pay" type="object" class="btn-primary" name="action_payment" />
                    <button string="Cancel" special="cancel" type="object"/>
                </footer>
            </form>
        </field>
</record>
    <record id="payment_views_action" model="ir.actions.act_window">
        <field name="name">Payment</field>
        <field name="res_model">pos.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>