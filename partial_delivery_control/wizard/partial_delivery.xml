<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="delivery_wizard_view_form" model="ir.ui.view">
        <field name="name">delivery.wizard.view.form</field>
        <field name="model">stock.backorder.confirmation</field>
         <field name="inherit_id"  ref="stock.view_backorder_confirmation" />
        <field name="arch" type="xml">
             <xpath expr="//button[@name='process']" position="before" >
                 <field name="approve_flag" invisible="1" />
                <button name="action_request" type="object" string="Request Approval" class="btn-primary" invisible="approve_flag == True"/>
                </xpath>
            <xpath expr="//button[@name='process']" position="attributes" >
                <attribute name="invisible">approve_flag == False</attribute>
                </xpath>
            <xpath expr="//button[@name='process_cancel_backorder']" position="attributes" >
                <attribute name="invisible">approve_flag == False</attribute>
                </xpath>

        </field>
</record>
</odoo>