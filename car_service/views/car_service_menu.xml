<odoo>
<data>

    <record id="fleet_kanban" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">fleet.vehicle.log.services</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


      <record id="car_quotation" model="ir.actions.act_window">
        <field name="name">Quotation</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="car_purchase" model="ir.actions.act_window">
        <field name="name">Purchase</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem id="car_service_root" name="Car Service"/>
    <menuitem id="car_service_kanban"
              name="customer" action="fleet_kanban"
              parent="car_service_root"/>
    <menuitem id="car_service_quotations"
              name="quotations"
              action="car_quotation"
              parent="car_service_root"/>
    <menuitem id="car_service_purchase"
              name="purchase"
              action="car_purchase"
              parent="car_service_root"/>

</data>
</odoo>