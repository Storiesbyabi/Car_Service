<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="qty_add_product" inherit_id="website_sale.shop_product_buttons" customize_show="True">
    <xpath expr="//div[hasclass('o_wsale_product_action_row')]" position="inside">
        <div id="add_to_cart_wrap" position="inside">
            <div
                    id="add_qty"
                t-attf-class="css_quantity input-group  align-middle border"
                contenteditable="false"
            >
                <a
                    t-attf-href="#"
                    class="css_quantity_minus btn btn-link pe-2 js_add_cart_json border-0"
                    aria-label="Remove one"
                    title="Remove one"
                    name="remove_one"
                >
                    <i class="oi oi-minus text-600"/>
                </a>
                <input
                    type="text"
                    t-attf-class="form-control quantity text-center border-0"
                    data-min="1"
                    name="add_qty"
                    t-att-value="1"
                />
                <a
                    t-attf-href="#"
                    class="css_quantity_plus btn btn-link ps-2 js_add_cart_json border-0"
                    aria-label="Add one"
                    title="Add one"
                >
                    <i class="oi oi-plus text-600"/>
                </a>
            </div>
        </div>
        <t t-log="Hello" />
    </xpath>
</template>
    </odoo>